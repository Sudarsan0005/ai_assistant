# ─────────────────────────────────────────────
#  Customer Support NL2SQL — Environment Config
# ─────────────────────────────────────────────

# Application
APP_NAME="Customer Support NL2SQL"
# development | production
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=true

# ── Internal Postgres (app database + vector store) ──
INTERNAL_DB_HOST=localhost
INTERNAL_DB_PORT=5432
INTERNAL_DB_NAME=cs_nl2sql
INTERNAL_DB_USER=postgres
INTERNAL_DB_PASSWORD=postgres

# ── OpenAI ──
OPENAI_API_KEY=your_openai_api_key_here
# query generation model
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── NL2SQL tuning ──
# reuse cached SQL above this score
VECTOR_SIMILARITY_THRESHOLD=0.95
# retry attempts on failed SQL
MAX_SQL_RETRIES=3
# hard cap on result rows
MAX_ROWS_RETURNED=100

# ── Data Sync ──
# how often to pull from source DB
SYNC_CRON_INTERVAL_MINUTES=30
# rows per insert batch
SYNC_BATCH_SIZE=500
