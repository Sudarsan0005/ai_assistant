# Application Configuration
APP_NAME=Advanced RAG System
APP_VERSION=1.0.0
DEBUG=False

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=rag_database
MILVUS_COLLECTION_NAME=document_chunks

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval Configuration
TOP_K=10
SIMILARITY_THRESHOLD=0.3
VECTOR_WEIGHT=0.7
KEYWORD_WEIGHT=0.3

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# API Keys (Required)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vision Processing
ENABLE_VISION=True
OCR_LANGUAGE=en
VISION_MODEL=paddleocr

# Citation Configuration
CITATION_THRESHOLD=0.63
MAX_CITATIONS_PER_SENTENCE=4
