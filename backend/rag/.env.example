# Application
APP_NAME=Advanced RAG System
APP_VERSION=2.0.0
DEBUG=False

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_chunks
QDRANT_PREFER_GRPC=False

# Embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval
TOP_K=10
SIMILARITY_THRESHOLD=0.3
VECTOR_WEIGHT=0.75
KEYWORD_WEIGHT=0.25
HYBRID_CANDIDATE_MULTIPLIER=3

# LLM routing
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# Provider credentials
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
NVIDIA_API_KEY=

# Vision
ENABLE_VISION=True
OCR_LANGUAGE=en
VISION_MODEL=paddleocr

# Citations
CITATION_THRESHOLD=0.63
MAX_CITATIONS_PER_SENTENCE=4
